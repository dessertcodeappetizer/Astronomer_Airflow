{
  "properties": {
    "url": {
      "description": "The API endpoint URL.",
      "title": "Url",
      "type": "string"
    },
    "method": {
      "default": "GET",
      "description": "HTTP method.",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "title": "Method",
      "type": "string"
    },
    "headers": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Optional request headers.",
      "title": "Headers",
      "type": "object"
    },
    "params": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Optional query parameters.",
      "title": "Params",
      "type": "object"
    },
    "data": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Optional JSON request body.",
      "title": "Data",
      "type": "object"
    },
    "timeout": {
      "default": 30,
      "description": "Request timeout in seconds.",
      "exclusiveMinimum": 0,
      "title": "Timeout",
      "type": "integer"
    },
    "blueprint": {
      "type": "string",
      "const": "api_call",
      "description": "The blueprint template to use"
    },
    "version": {
      "type": "integer",
      "const": 1,
      "description": "The blueprint version"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Steps that must complete before this step runs",
      "default": []
    },
    "trigger_rule": {
      "type": "string",
      "enum": [
        "all_done",
        "all_done_min_one_success",
        "all_done_setup_success",
        "all_failed",
        "all_skipped",
        "all_success",
        "always",
        "none_failed",
        "none_failed_min_one_success",
        "none_skipped",
        "one_done",
        "one_failed",
        "one_success"
      ],
      "description": "Trigger rule for this step (default: all_success)"
    }
  },
  "required": [
    "blueprint",
    "version",
    "url"
  ],
  "title": "api_call",
  "type": "object",
  "templateType": "blueprint",
  "$schema": "http://json-schema.org/draft-07/schema#"
}